# --- Slack ---
# Bot User OAuth Token from your Slack App (OAuth & Permissions, needs chat:write)
# Leave SLACK_BOT_TOKEN or SLACK_CHANNEL empty to run in dry-run mode (alerts logged only)
SLACK_BOT_TOKEN=

# Channel name (#alerts) or channel ID (C0123456789). Invite the bot first: /invite @your-bot
SLACK_CHANNEL=

# Timeout in seconds for each Slack API call
SEND_TIMEOUT=5

# --- Intervals (seconds) ---
CRITICAL_INTERVAL=60
STANDARD_INTERVAL=300

# --- Ping ---
PING_TIMEOUT=2

# --- Config ---
DEVICES_CONFIG=config/devices.json

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
